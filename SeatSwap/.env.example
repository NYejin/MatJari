# docker-compose.yml이 참조하는 값. 복사해서 .env로 저장 후 값 채우기.
DB_PASSWORD=changeme
JWT_SECRET=changeme-dev-secret

# 소셜 로그인(선택). 값이 있는 제공자만 로그인 화면에 버튼이 보인다.
# 각 개발자 콘솔에서 앱을 만들고 Redirect URI 를 {SOCIAL_BACKEND_BASE_URL}/api/auth/social/{google|kakao|naver}/callback 으로 등록한다.
# (기본: http://localhost:8080/api/auth/social/kakao/callback 등)
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_NAVER_CLIENT_ID=
SOCIAL_NAVER_CLIENT_SECRET=
SOCIAL_BACKEND_BASE_URL=http://localhost:8080
SOCIAL_FRONTEND_BASE_URL=http://localhost:5173

# 가입 전 이메일 인증번호(일반 회원가입).
# MAIL_MODE=log(기본): 실제로 보내지 않고 백엔드 로그에 메일 내용을 찍는다(개발용). 운영(백엔드 주소가 localhost 가 아님)에서 log 면 기동이 거부된다.
# MAIL_MODE=smtp: 아래 SMTP 값을 채운다. 예) Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=내계정@gmail.com,
#   MAIL_PASSWORD=구글 계정의 '앱 비밀번호'(2단계 인증을 켠 뒤 발급). 하루 발송 한도가 있어 시연용으로만 쓴다. 서비스용은 SES·Resend 등을 쓴다.
MAIL_MODE=log
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 인증번호 해시 키(운영에서는 새로 만든 긴 무작위 값: openssl rand -base64 48)
EMAIL_CODE_SECRET=dev-only-insecure-email-code-secret-please-override
