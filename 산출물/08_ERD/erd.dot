// SeatSwap ERD -- 현재 스키마: V1~V11 (users, performance, performance_session, ticket + 교환 희망 4개 + 매칭·잠금 2개 + 교환 이력 1개 + 알림 1개 + 채팅 2개 = 14개 테이블; V6·V7은 컬럼 변경만, V9는 ticket.status EXCHANGED 추가와 exchange_history 신설, V10은 notification 신설, V11은 chat_message·chat_read_state 신설)
// 생성: dot -Tpng erd.dot -o ERD.png   (한글 라벨: 나눔고딕 등 한글 폰트 필요)
// 2026-10-07 방향 전환으로 좌석표 트랙(좌석표·수정 로그·신고·제재 테이블)과 후기 테이블을 제외하고 새로 작성. 이후 교환 테이블이 V4~V8로 구현되어 현재 색으로 추가됐다.
// 이전 설계(12~16개 테이블)는 git 태그 archive/seatmap-track-20261007 에 보관되어 있다.
// 기준: SeatSwap/backend/src/main/resources/db/migration/V1__init_schema.sql + V2__drop_venue_use_venue_name.sql + V3__ticket_seat_columns.sql + V4__exchange_want_tables.sql + V5__exchange_match_tables.sql + V6__exchange_extra_per_range.sql + V7__exchange_request_soft_delete.sql + V8__exchange_match_single_reserve.sql + V9__exchange_complete_history.sql + V10__notification.sql + V11__chat_message.sql
// 2026-10-08: V3에서 ticket에 구역·열·번(label+key)·status·시각 추가(구현 완료).
// 2026-10-08: V4(V4__exchange_want_tables.sql)로 exchange_request·exchange_want_range·exchange_want_seat·exchange_want_session 구현 완료(현재). (당시 메모) 차단·매칭·잠금·채팅·이력은 예정이었다 -> 현재: 매칭·잠금은 V5 구현, 차단·채팅·이력은 V9 이후
// 2026-10-08: V5(V5__exchange_match_tables.sql)로 exchange_match·exchange_ticket_lock 구현 완료(현재). user_block·chat_message·exchange_history는 예정(V9 이후)
// 2026-10-09: V6(V6__exchange_extra_per_range.sql) = 추가금을 요청에서 희망 범위(want_range)·펼친 좌석(want_seat)으로 이동하고 매칭에 추가금 스냅샷 4컬럼 추가, V7(V7__exchange_request_soft_delete.sql) = 요청 소프트 삭제(DELETED, deleted_at, live_flag 유일 키) 구현 완료(현재, 7차 답변). 예정은 노랑 본문·주황 헤더 = user_block·chat_message·exchange_history(V9 이후). 상세: exchange-schema-design.md 9절
// 2026-10-10: V8(V8__exchange_match_single_reserve.sql) 구현 완료(현재, feature/exchange-reserve) = exchange_match에 reserved_by_id(FK users, NULL)·reserved_at 추가(한 명 예약 방식), a/b_reserved_at은 미사용 레거시(DEPRECATED 주석), CHECK 3개(ck_exchange_match_reserved·ck_exchange_match_reserved_by_party·ck_exchange_match_completed). 상세: exchange-schema-design.md 10절. 테이블 수는 그대로 10개
// 2026-10-11: V9(V9__exchange_complete_history.sql) 구현 완료(현재, feature/exchange-complete) = ticket.status에 EXCHANGED 추가(ck_ticket_status 확장), exchange_history 신설(교환 완료 시 사용자별 1행씩 2행, old/new_ticket_id UK, 스냅샷). V10(V10__notification.sql) 구현 완료(현재, feature/notifications) = notification 신설(수신자별 알림, dedup_key 단일 유니크, type·match_id CHECK, 안 읽은 개수용 생성 컬럼). V11(V11__chat_message.sql) 구현 완료(현재, feature/chat) = chat_message(append-only, 본문 VARCHAR(1000), client_message_id + sender_id 유니크)와 chat_read_state(매칭·사용자당 1행, 마지막 읽은 메시지 id 포인터, 단조 증가) 신설. 다음 마이그레이션은 V12부터: user_block(예정, 노랑/주황 + 점선)
// 2026-10-08: V2에서 venue 테이블 삭제, 공연장은 performance.venue_name 텍스트(등록 후 수정 불가)
// 시각 컬럼(created_at, updated_at, starts_at 등)은 모두 KST(Asia/Seoul) 벽시계 시각
digraph SeatSwapERD {
  graph [rankdir=LR, fontname="NanumGothic,Malgun Gothic", fontsize=12, labelloc=t, nodesep=0.5, ranksep=1.2, splines=true,
         label=<<B>SeatSwap ERD - 현재 스키마 (V1~V11, 14개 테이블)</B><BR/>시각 컬럼은 모두 KST 기준 / 교환 희망 4개는 V4, 매칭·예약 잠금 2개는 V5, 범위별 추가금·요청 소프트 삭제는 V6·V7, 한 명 예약 방식은 V8 적용, 교환 완료·이력은 V9 적용, 알림은 V10 적용, 채팅은 V11 적용 / 차단은 V12 예정>];
  node  [shape=plain, fontname="NanumGothic,Malgun Gothic", fontsize=10];
  edge  [fontname="NanumGothic,Malgun Gothic", fontsize=9, dir=both, arrowtail=tee, arrowhead=crow];

  // ---------- 범례 ----------
  legend [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#DDDDDD"><B>범례</B></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF" WIDTH="18"> </TD><TD ALIGN="LEFT">현재 (V1~V11)</TD></TR>
      <TR><TD>PK/FK/UK</TD><TD ALIGN="LEFT">키 / 제약</TD></TR>
      <TR><TD>NN</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC" WIDTH="18"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">예정 (설계 초안, 미구현)</TD></TR>
    </TABLE>>];

  // ---------- 회원 ----------
  users [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>users</B> (User)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">email (255, NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">nickname (255, NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">password (255, NN, BCrypt)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">trust_score (DOUBLE)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">role (USER/ADMIN, NN, 기본 USER, utf8mb4_bin + CHECK)</TD></TR>
    </TABLE>>];

  // ---------- 공연 / 회차 ----------
  performance [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>performance</B> (Performance)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">registrant_id → users (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">title (200, NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">venue_name VARCHAR(100) NN (공연장 이름 텍스트, 등록 후 수정 불가)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">source_url (2048, NN)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">source_key (500, NN, utf8mb4_bin)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at / updated_at (NN)</TD></TR>
    </TABLE>>];

  performance_session [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>performance_session</B> (PerformanceSession)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK,UK</TD><TD ALIGN="LEFT">performance_id → performance (NN)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">starts_at (NN, 분 단위, KST)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at (NN)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">uk_performance_session_performance_starts_at (performance_id, starts_at)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_performance_session_starts_at (starts_at)</TD></TR>
    </TABLE>>];

  // ---------- 티켓 ----------
  ticket [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>ticket</B> (Ticket)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id → users (NN, 보유자)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">performance_session_id → performance_session (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">zone_label VARCHAR(50) NN (구역, 표시용)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">zone_key VARCHAR(50) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">row_label VARCHAR(20) NN (열, 표시용)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">row_key VARCHAR(20) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">col_label VARCHAR(20) NN (번, 표시용)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">col_key VARCHAR(20) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">status (ACTIVE/INACTIVE/EXCHANGED, NN, 기본 ACTIVE, bin + CHECK; EXCHANGED는 V9)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">EXCHANGED = 교환 완료된 기존 티켓(내리기 불가), 교환 완료 시 각자 새 티켓 INSERT</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">active_flag TINYINT (생성 컬럼: ACTIVE면 1, 아니면 NULL)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at / updated_at (NN)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">uk_ticket_active_seat (performance_session_id, zone_key, row_key, col_key, active_flag)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_ticket_user_status (user_id, status)</TD></TR>
    </TABLE>>];

  // ---------- 주석 노드 ----------
  note_scope [shape=note, fontsize=10, label="교환 범위는 공연(Performance) 단위 (2026-10-07):\l같은 공연의 다른 회차 티켓끼리도 교환 가능.\lticket은 회차만 참조하고 공연은 performance_session.performance로 얻는다.\l"];
  note_design [shape=note, fontsize=10, style=filled, fillcolor="#FFF2CC", label="노랑·주황색 = 예정 (V12 이후, 구현 전. 교환 희망 4개는 V4, 매칭·잠금 2개는 V5, 범위별 추가금·소프트 삭제는 V6·V7, 한 명 예약 방식은 V8, 교환 완료·이력·EXCHANGED는 V9, 알림은 V10, 채팅은 V11으로 구현 완료)\l상세: 산출물/08_ERD/exchange-schema-design.md\l후기·신뢰도 테이블 없음, 신고는 후속.\l교환 완료 후 기존 티켓의 교환 요청은 CLOSED, 그 티켓의 다른 CHATTING 매칭은 자동 취소하지 않음(Q-15)\l"];

  // ---------- 교환 도메인: 희망 4개 테이블은 현재(V4), 매칭·잠금은 현재(V5), 교환 이력(V9)·채팅(V11)은 현재, 차단(user_block)은 예정(V12) ----------
  exchange_request [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_request</B> (ExchangeRequest, V4)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">ticket_id → ticket (NN, 미삭제 요청은 티켓당 1개)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">(extra_type, extra_amount는 V6에서 제거 — 추가금은 want_range 단위)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">status (OPEN/CLOSED/DELETED, NN, 기본 OPEN, bin + CHECK; V7)</TD></TR>
      <TR><TD>V7</TD><TD ALIGN="LEFT">DELETED 상태 (소프트 삭제, 후보 제외, 하위 행은 삭제)</TD></TR>
      <TR><TD>V7</TD><TD ALIGN="LEFT">deleted_at DATETIME(6) NULL (DELETED일 때만 값)</TD></TR>
      <TR><TD>V7</TD><TD ALIGN="LEFT">live_flag TINYINT 생성 컬럼 (DELETED면 NULL, 아니면 1)</TD></TR>
      <TR><TD>V7</TD><TD ALIGN="LEFT">uk_exchange_request_live_ticket (live_flag, ticket_id) 로 교체 + FK용 idx_exchange_request_ticket (ticket_id)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at / updated_at (NN)</TD></TR>
    </TABLE>>];

  exchange_want_range [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_want_range</B> (ExchangeWantRange, V4, 입력한 범위)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">request_id → exchange_request (NN, ON DELETE CASCADE)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">zone_label VARCHAR(50) NN / zone_key VARCHAR(50) NN (bin)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">row_from, row_to, col_from, col_to VARCHAR(20) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">sort_order SMALLINT NN (CHECK &gt;= 0)</TD></TR>
      <TR><TD>V6</TD><TD ALIGN="LEFT">extra_type VARCHAR(10) NN (X/ANY/POS/NEG, bin + CHECK)</TD></TR>
      <TR><TD>V6</TD><TD ALIGN="LEFT">extra_amount INT NULL (POS &gt; 0, NEG &lt; 0, 표시용)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_exchange_want_range_request (request_id, sort_order)</TD></TR>
    </TABLE>>];

  exchange_want_seat [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_want_seat</B> (ExchangeWantSeat, V4, 펼친 좌석)</TD></TR>
      <TR><TD>PK,FK</TD><TD ALIGN="LEFT">request_id → exchange_request (ON DELETE CASCADE)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">zone_key VARCHAR(50), row_key VARCHAR(20), col_key VARCHAR(20) (bin)</TD></TR>
      <TR><TD>V6</TD><TD ALIGN="LEFT">extra_type VARCHAR(10) NN, extra_amount INT NULL (좌석이 속한 범위의 추가금, PK 불변, 겹침은 서비스가 422 WANT_EXTRA_CONFLICT로 거부)</TD></TR>
    </TABLE>>];

  exchange_want_session [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_want_session</B> (ExchangeWantSession, V4, 희망 회차)</TD></TR>
      <TR><TD>PK,FK</TD><TD ALIGN="LEFT">request_id → exchange_request (ON DELETE CASCADE)</TD></TR>
      <TR><TD>PK,FK</TD><TD ALIGN="LEFT">performance_session_id → performance_session</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">priority SMALLINT NN (1이 최우선, CHECK &gt;= 1)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_exchange_want_session_session (performance_session_id)</TD></TR>
    </TABLE>>];

  user_block [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>user_block</B> (예정, V12)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK,UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">blocker_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK,UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">blocked_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">created_at</TD></TR>
    </TABLE>>];

  exchange_match [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_match</B> (ExchangeMatch, V5, 매칭=채팅방)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">request_a_id, request_b_id → exchange_request (NN, CHECK a &lt;&gt; b)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">ticket_a_id, ticket_b_id → ticket (NN, ck_exchange_match_distinct_tickets)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_a_id, user_b_id → users (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">status (CHATTING/RESERVED/COMPLETED/CANCELED, bin + CHECK) 취소=재매칭 가능</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">a/b_reserved_at (V8: 미사용 레거시), a/b_completed_at (NULL 허용, 교환 수락 표시, 예약 취소 시 초기화, V8 ck_exchange_match_completed: CHATTING이면 NULL·COMPLETED면 둘 다 NN)</TD></TR>
      <TR><TD>FK (V8)</TD><TD ALIGN="LEFT">reserved_by_id BIGINT NULL, FK → users (예약한 사람, idx_exchange_match_reserved_by 단일 컬럼)</TD></TR>
      <TR><TD>V8</TD><TD ALIGN="LEFT">reserved_at DATETIME(6) NULL; ck_exchange_match_reserved: RESERVED일 때만 reserved_by_id·reserved_at NOT NULL, 아니면 둘 다 NULL</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">canceled_by_id → users (NULL=시스템), canceled_at (ck_exchange_match_canceled)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at / updated_at (NN)</TD></TR>
      <TR><TD>V6</TD><TD ALIGN="LEFT">a_extra_type, a_extra_amount, b_extra_type, b_extra_amount (매칭 시점 적용 추가금 스냅샷)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">uk_exchange_match_open_pair (request_low, request_high, open_flag) 생성 컬럼</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx: user_a_id / user_b_id (단일 컬럼 FK 인덱스), request_a / request_b, ticket_a / ticket_b</TD></TR>
    </TABLE>>];

  exchange_ticket_lock [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_ticket_lock</B> (ExchangeTicketLock, V5, 예약 잠금)</TD></TR>
      <TR><TD>PK,FK</TD><TD ALIGN="LEFT">ticket_id → ticket (티켓당 1개, ON DELETE CASCADE)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">match_id → exchange_match (NN, ON DELETE CASCADE)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at (NN)</TD></TR>
    </TABLE>>];

  chat_message [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>chat_message</B> (ChatMessage, V11, 채팅 메시지, append-only)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">match_id → exchange_match (NN)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">sender_id → users (NN, 보낸 사람)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">content VARCHAR(1000) NN (텍스트만, CHECK 공백 아님, 1000자는 앱에서 코드 포인트 기준 검사)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">client_message_id VARCHAR(36) NN (ascii_bin, 8~36자) + sender_id: uk_chat_message_client (재전송 멱등)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at DATETIME(6) NN</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx: idx_chat_message_match (match_id, 목록 조회) / idx_chat_message_sender (sender_id)</TD></TR>
    </TABLE>>];

  chat_read_state [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>chat_read_state</B> (V11, 읽음 포인터, 매칭·사용자당 1행)</TD></TR>
      <TR><TD>PK,FK</TD><TD ALIGN="LEFT">match_id → exchange_match (NN)</TD></TR>
      <TR><TD>PK,FK</TD><TD ALIGN="LEFT">user_id → users (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">last_read_message_id BIGINT NN (chat_message.id, FK 아님, 0 = 읽은 것 없음, CHECK &gt;= 0, 단조 증가)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">updated_at DATETIME(6) NN</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_chat_read_state_user (user_id)</TD></TR>
    </TABLE>>];

  exchange_history [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>exchange_history</B> (ExchangeHistory, V9, 교환 이력 스냅샷)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">match_id → exchange_match (NN)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id → users (NN, 이력 주인)</TD></TR>
      <TR><TD>FK,UK</TD><TD ALIGN="LEFT">old_ticket_id → ticket (NN, 교환 전 내 티켓, 완료 후 EXCHANGED)</TD></TR>
      <TR><TD>FK,UK</TD><TD ALIGN="LEFT">new_ticket_id → ticket (NN, 교환으로 생긴 새 티켓)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">performance_id → performance (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">performance_title VARCHAR(200), venue_name VARCHAR(100) (NN, 스냅샷)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">old_starts_at, new_starts_at DATETIME(6) (NN, 스냅샷)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">old_/new_ zone_label(50), row_label(20), col_label(20) (NN, 스냅샷)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at (NN)</TD></TR>
      <TR><TD>CHECK</TD><TD ALIGN="LEFT">ck_exchange_history_tickets (old_ticket_id &lt;&gt; new_ticket_id)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx: match_id / user_id / performance_id (단일 컬럼 FK 인덱스)</TD></TR>
    </TABLE>>];

  notification [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>notification</B> (Notification, V10, 알림)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id → users (NN, 수신자)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">match_id → exchange_match (NN, 3종 모두 필수)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">type VARCHAR(40) NN (PROPOSAL_RECEIVED / MATCH_RESERVED / RESERVATION_CANCELED, CHECK)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">dedup_key VARCHAR(100) NULL (PROPOSAL_RECEIVED:{matchId}만, 예약·예약 취소는 NULL)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">read_at DATETIME(6) NULL (NULL = 안 읽음)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">unread_user_id (생성 컬럼: 안 읽었으면 user_id, 안 읽은 개수 인덱스용, FK 아님)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at DATETIME(6) NN</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx: user_id / match_id (단일 컬럼 FK 인덱스), unread_user_id</TD></TR>
    </TABLE>>];

  // ---------- 관계 ----------
  performance -> performance_session [label="1:N"];
  performance_session -> ticket [label="1:N"];
  users -> ticket [label="1:N 보유자"];
  users -> performance [label="1:N 등록자"];

  ticket -> exchange_request [label="1:0..1 미삭제 (V7)"];
  exchange_request -> exchange_want_range [label="1:N"];
  exchange_request -> exchange_want_seat [label="1:N 펼침"];
  exchange_request -> exchange_want_session [label="1:N"];
  performance_session -> exchange_want_session [label="1:N"];
  // ---------- 현재 관계(실선) / 예정 관계(점선, V12 이후) ----------
  exchange_request -> exchange_match [label="1:N (a측/b측)"];
  users -> exchange_match [label="1:N (a/b)"];
  users -> exchange_match [label="1:N 예약자 reserved_by_id (V8)"];
  ticket -> exchange_match [label="1:N (a/b)"];
  users -> user_block [style=dashed, color="#C55A11", label="1:N 차단자/피차단자"];
  exchange_match -> exchange_ticket_lock [label="1:N (최대 2)"];
  ticket -> exchange_ticket_lock [label="1:0..1"];
  exchange_match -> chat_message [label="1:N"];
  users -> chat_message [label="1:N 발신자"];
  exchange_match -> chat_read_state [label="1:N"];
  users -> chat_read_state [label="1:N 읽은 사람"];
  exchange_match -> exchange_history [label="1:N (최대 2)"];
  users -> exchange_history [label="1:N"];
  ticket -> exchange_history [label="1:N old/new_ticket_id"];
  users -> notification [label="1:N 수신자"];
  exchange_match -> notification [label="1:N (알림 대상 매칭)"];

  // ---------- 배치 보조 ----------
  legend -> users [style=invis];
  performance_session -> note_scope [style=dotted, arrowhead=none, arrowtail=none, color=gray, label=""];
  ticket -> note_design [style=dotted, arrowhead=none, arrowtail=none, color=gray, label=""];
}
