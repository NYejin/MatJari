# docker-compose.yml이 참조하는 값. 복사해서 .env로 저장 후 값 채우기.
DB_PASSWORD=changeme
JWT_SECRET=changeme-dev-secret

# 소셜 로그인(선택). 값이 있는 제공자만 로그인 화면에 버튼이 보인다.
# 각 개발자 콘솔에서 앱을 만들고 Redirect URI 를 {SOCIAL_BACKEND_BASE_URL}/api/auth/social/{google|kakao|naver}/callback 으로 등록한다.
# (기본: http://localhost:8080/api/auth/social/kakao/callback 등)
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_NAVER_CLIENT_ID=
SOCIAL_NAVER_CLIENT_SECRET=
SOCIAL_BACKEND_BASE_URL=http://localhost:8080
SOCIAL_FRONTEND_BASE_URL=http://localhost:5173
